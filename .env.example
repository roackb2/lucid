# Lucid delegated discovery
HOST=127.0.0.1
PORT=8081
LOG_LEVEL=info
LUCID_WEB_ORIGIN=http://127.0.0.1:3080

# Loopback development maps the local socket to the seeded private user. A
# remotely bound private pilot must use distinct high-entropy bearer tokens.
LUCID_AUTH_MODE=development
# LUCID_AUTH_MODE=static-token
# LUCID_USER_TOKEN=replace-with-at-least-32-random-characters
# LUCID_OPERATOR_TOKEN=replace-with-a-different-32-character-secret
# Hosted multi-user preview. The browser key is public configuration; the
# operator token remains a server-only break-glass secret.
# LUCID_AUTH_MODE=supabase
# LUCID_SUPABASE_PROJECT_URL=https://project-ref.supabase.co
# LUCID_ALLOW_SELF_ENROLLMENT=false
# LUCID_OPERATOR_TOKEN=replace-with-a-server-only-32-character-secret

# PostgreSQL is Lucid's product persistence backend. Apply the checked-in
# Lucid migrations before starting the server. The separate coordinator owns
# heartbeat tables and its own Drizzle history in this same application DB.
# Never commit the real URL.
LUCID_DATABASE_URL=postgresql://user:password@host:5432/lucid?sslmode=require

# Each Interest check is one bounded Heddle agent loop.
LUCID_MODEL=gpt-5.4-mini
LUCID_MAX_STEPS=7

# Lucid publishes this desired cadence to the required Heddle Coordinator.
# For a bounded local periodic proof, use gpt-5.6-luna and 60000, observe two
# schedule-only checks, then pause dispatch. Keep the 15-minute default outside
# that short supervised proof.
LUCID_HEARTBEAT_INTERVAL_MS=900000

# Required external Execution Host and heartbeat Coordinator profile. For the
# standard local deployment, copy lucid-deployment's `lucid.env.example` to
# ignored `.env.heddle.local` and set only the generic credential-bundle
# directory. Deployment operators can instead provide the individual values or
# their conventional `_FILE` variants. PUBLIC_URL must be reachable by the host
# because it publishes JWKS and scoped Lucid MCP.
# LUCID_HOSTED_EXECUTION_ENABLED=true
# LUCID_HOSTED_EXECUTION_CREDENTIAL_DIRECTORY=/absolute/path/to/lucid-deployment/local/lucid-local/credentials
# The authority issuer stays on loopback. The local Runtime command derives
# Docker Desktop's host alias only for its JWKS and MCP callbacks.
# LUCID_HOSTED_EXECUTION_PUBLIC_URL=http://127.0.0.1:8081
# Direct is the default local-development transport.
# LUCID_HOSTED_EXECUTION_TRANSPORT=direct
# LUCID_HOSTED_EXECUTION_HOST_URL=http://127.0.0.1:18080
# LUCID_HOSTED_EXECUTION_LOCAL_TOKEN=replace-with-at-least-32-random-characters
# LUCID_HOSTED_EXECUTION_LOCAL_TOKEN_FILE=/run/secrets/execution-host-local-token
# Managed AgentCore replaces HOST_URL and LOCAL_TOKEN with these fields. The
# AWS SDK uses its standard credential chain; do not put AWS keys in this file.
# LUCID_HOSTED_EXECUTION_TRANSPORT=agentcore
# LUCID_HOSTED_EXECUTION_AGENTCORE_REGION=us-east-2
# LUCID_HOSTED_EXECUTION_AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-2:123456789012:runtime/example_runtime
# LUCID_HOSTED_EXECUTION_AGENTCORE_QUALIFIER=DEFAULT
# By default Lucid acquires an access-token-only credential from its existing
# Heddle Codex login. This optional field explicitly selects API-key mode.
# LUCID_HOSTED_EXECUTION_MODEL_API_KEY=replace-with-a-model-api-key
# LUCID_HOSTED_EXECUTION_MODEL_API_KEY_FILE=/run/secrets/model-api-key
# LUCID_HOSTED_EXECUTION_SIGNING_JWK_PATH=local/hosted-execution/es256-private.jwk.json
# LUCID_HOSTED_EXECUTION_ADOPTER_ID=lucid-local
# LUCID_HOSTED_EXECUTION_TENANT_ID=lucid-local
# LUCID_HOSTED_EXECUTION_PRODUCT_SESSION_ID=local-discovery-workspace
# LUCID_HOSTED_EXECUTION_KEY_ID=lucid-local-key
# LUCID_HOSTED_EXECUTION_AUDIENCE=urn:heddle-execution-host:lucid-local
# LUCID_HOSTED_EXECUTION_MCP_AUDIENCE=urn:lucid:mcp:local
# LUCID_HOSTED_EXECUTION_MCP_SERVER_ID=lucid_product
# LUCID_HOSTED_EXECUTION_MAX_TURN_MS=600000
# The execution token authenticates Coordinator -> Lucid work lifecycle calls.
# The separate API token authenticates Lucid -> coordinator desired-task calls.
# LUCID_HOSTED_HEARTBEAT_EXECUTION_TOKEN=replace-with-a-distinct-32-character-secret
# LUCID_HOSTED_HEARTBEAT_EXECUTION_TOKEN_FILE=/run/secrets/coordinator-product-execution-token
# LUCID_HOSTED_HEARTBEAT_COORDINATOR_URL=http://127.0.0.1:18082
# LUCID_HOSTED_HEARTBEAT_COORDINATOR_API_TOKEN=replace-with-another-32-character-secret
# LUCID_HOSTED_HEARTBEAT_COORDINATOR_API_TOKEN_FILE=/run/secrets/coordinator-api-token

# Web app. Vite proxies the same-origin default during local development.
# These development-only values make multiple worktree-local web/server pairs
# independently addressable without changing browser transport semantics.
LUCID_WEB_PORT=3080
LUCID_SERVER_ORIGIN=http://127.0.0.1:8081
# VITE_LUCID_API_URL=http://127.0.0.1:8081/api/trpc
# VITE_SUPABASE_URL=https://project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-a-publishable-browser-key
# LUCID_WEB_ROOT=apps/web/dist
