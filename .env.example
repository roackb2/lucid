# Lucid delegated discovery
HOST=127.0.0.1
PORT=8081
LOG_LEVEL=info
LUCID_WEB_ORIGIN=http://127.0.0.1:3080

# Loopback development maps the local socket to the seeded private user. A
# remotely bound private pilot must use distinct high-entropy bearer tokens.
LUCID_AUTH_MODE=development
# LUCID_AUTH_MODE=static-token
# LUCID_PARTICIPANT_TOKEN=replace-with-at-least-32-random-characters
# LUCID_OPERATOR_TOKEN=replace-with-a-different-32-character-secret

# Optional. Defaults to local/discovery-home and contains Heddle's local runtime
# artifacts. Authoritative product, task, checkpoint, and run state is in
# PostgreSQL.
# LUCID_STATE_ROOT=local/discovery-home

# PostgreSQL is Lucid's only persistence backend. Apply the checked-in
# migrations before starting the server. Never commit the real URL.
LUCID_DATABASE_URL=postgresql://user:password@host:5432/lucid?sslmode=require

# Each representative-agent wake is one bounded Heddle agent loop.
LUCID_MODEL=gpt-5.4-mini
LUCID_MAX_STEPS=7

# Every representative has one periodic task. New mailbox messages also make
# the recipient task due immediately.
LUCID_HEARTBEAT_INTERVAL_MS=900000
LUCID_HEARTBEAT_POLL_MS=1000
# Independent representatives can work in parallel. Keep this bounded so one
# local Lucid process cannot create unbounded model traffic.
LUCID_HEARTBEAT_MAX_CONCURRENCY=3

# One-shot targeted workers are the default. The long-lived scheduler can be
# selected for execution-topology comparison while using the same PostgreSQL
# authorities.
# LUCID_HEARTBEAT_HOST=scheduler
# LUCID_HEARTBEAT_HOST=targeted
LUCID_HEARTBEAT_NAMESPACE=lucid:representatives
# Must exceed the maximum bounded worker attempt. The local hosted proof uses
# a 20-minute lease for a worker that will later have a 15-minute hard limit.
LUCID_HEARTBEAT_EXECUTION_LEASE_MS=1200000
# The API host checks for expired claims once per minute. A bounded invocation
# receives a cooperative cancellation signal after 12 minutes.
LUCID_HEARTBEAT_RECOVERY_INTERVAL_MS=60000
LUCID_HEARTBEAT_INVOCATION_TIMEOUT_MS=720000

# Heddle uses an existing Codex login by default. Set this to true and provide
# OPENAI_API_KEY if API-key authentication is preferred.
LUCID_PREFER_API_KEY=false
# OPENAI_API_KEY=

# Optional external Execution Host conversation profile. Generate the signing
# key with `yarn hosted:generate-key`. PUBLIC_URL must be reachable by the host
# because it publishes JWKS and the scoped Lucid MCP endpoint. Keep all real
# values outside version control.
# LUCID_HOSTED_EXECUTION_ENABLED=true
# LUCID_HOSTED_EXECUTION_PUBLIC_URL=http://127.0.0.1:8081
# Direct is the default local-development transport.
# LUCID_HOSTED_EXECUTION_TRANSPORT=direct
# LUCID_HOSTED_EXECUTION_HOST_URL=http://127.0.0.1:18080
# LUCID_HOSTED_EXECUTION_LOCAL_TOKEN=replace-with-at-least-32-random-characters
# Managed AgentCore replaces HOST_URL and LOCAL_TOKEN with these fields. The
# AWS SDK uses its standard credential chain; do not put AWS keys in this file.
# LUCID_HOSTED_EXECUTION_TRANSPORT=agentcore
# LUCID_HOSTED_EXECUTION_AGENTCORE_REGION=us-east-2
# LUCID_HOSTED_EXECUTION_AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-2:123456789012:runtime/example_runtime
# LUCID_HOSTED_EXECUTION_AGENTCORE_QUALIFIER=DEFAULT
# LUCID_HOSTED_EXECUTION_MODEL_API_KEY=replace-with-a-model-api-key
# LUCID_HOSTED_EXECUTION_SIGNING_JWK_PATH=local/hosted-execution/es256-private.jwk.json
# LUCID_HOSTED_EXECUTION_ADOPTER_ID=lucid-local
# LUCID_HOSTED_EXECUTION_TENANT_ID=lucid-local
# LUCID_HOSTED_EXECUTION_PRODUCT_SESSION_ID=local-discovery-workspace
# LUCID_HOSTED_EXECUTION_KEY_ID=lucid-local-key
# LUCID_HOSTED_EXECUTION_AUDIENCE=urn:heddle-execution-host:lucid-local
# LUCID_HOSTED_EXECUTION_MCP_AUDIENCE=urn:lucid:mcp:local
# LUCID_HOSTED_EXECUTION_MCP_SERVER_ID=lucid_product
# LUCID_HOSTED_EXECUTION_MAX_TURN_MS=600000

# Web app. Vite proxies the same-origin default during local development.
# VITE_LUCID_API_URL=http://127.0.0.1:8081/api/trpc
# LUCID_WEB_ROOT=apps/web/dist
