# Lucid First Return
HOST=127.0.0.1
PORT=8081
LOG_LEVEL=info
LUCID_WEB_ORIGIN=http://127.0.0.1:3080

# Optional. Defaults to local/first-return and contains both lucid.sqlite and
# Heddle's durable conversation state.
# LUCID_STATE_ROOT=local/first-return

# Each wake is one Heddle conversation turn.
LUCID_MODEL=gpt-5.4-mini
LUCID_MAX_STEPS=7

# Heddle uses an existing Codex login by default. Set this to true and provide
# OPENAI_API_KEY if API-key authentication is preferred.
LUCID_PREFER_API_KEY=false
# OPENAI_API_KEY=

# Web app. Defaults to the local server.
# VITE_LUCID_API_URL=http://127.0.0.1:8081
