# Lucid delegated discovery
HOST=127.0.0.1
PORT=8081
LOG_LEVEL=info
LUCID_WEB_ORIGIN=http://127.0.0.1:3080

# Optional. Defaults to local/discovery-home and contains both lucid.sqlite and
# Heddle's durable heartbeat tasks, checkpoints, and run history.
# LUCID_STATE_ROOT=local/discovery-home

# SQLite is the zero-setup default. PostgreSQL can run the product repository
# in a single server process today, but is not a distributed heartbeat host
# until Heddle's targeted-worker/store contract is released. Never commit the
# real URL.
# LUCID_DATABASE_DRIVER=postgres
# LUCID_DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Each representative-agent wake is one bounded Heddle agent loop.
LUCID_MODEL=gpt-5.4-mini
LUCID_MAX_STEPS=7

# Every representative has one periodic task. New mailbox messages also make
# the recipient task due immediately.
LUCID_HEARTBEAT_INTERVAL_MS=900000
LUCID_HEARTBEAT_POLL_MS=1000
# Independent representatives can work in parallel. Keep this bounded so one
# local Lucid process cannot create unbounded model traffic.
LUCID_HEARTBEAT_MAX_CONCURRENCY=3

# Heddle uses an existing Codex login by default. Set this to true and provide
# OPENAI_API_KEY if API-key authentication is preferred.
LUCID_PREFER_API_KEY=false
# OPENAI_API_KEY=

# Web app. Defaults to the local server.
# VITE_LUCID_API_URL=http://127.0.0.1:8081
