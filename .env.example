# Lucid TS server
PORT=8081
LOG_LEVEL=info
LUCID_LOG_FILE=local/logs/server.log

# Defaults match the local Docker command used during development.
LUCID_DATABASE_URL=postgres://lucid:12345678@localhost:5432/lucid?sslmode=disable

# Required when running real Heddle-backed agent cycles.
OPENAI_API_KEY=

# Optional: override which workspace Heddle should inspect/edit for Lucid agent runs.
# By default, the Lucid repo root is used.
LUCID_AGENT_WORKSPACE_ROOT=
