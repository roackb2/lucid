{
  "name": "@lucid/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "types": "./src/router.ts",
      "default": "./dist/router.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:generate:postgres": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:postgres": "tsx src/migrate-postgres.ts",
    "test": "vitest run",
    "test:postgres": "LUCID_REQUIRE_POSTGRES_TESTS=1 vitest run src/database/postgres-discovery-repository.integration.test.ts"
  },
  "dependencies": {
    "@roackb2/heddle": "5.8.0",
    "@trpc/server": "11.16.0",
    "async-mutex": "0.5.0",
    "better-sqlite3": "^12.4.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "lodash": "^4.18.1",
    "pino": "^10.3.1",
    "postgres": "3.4.9",
    "superjson": "^2.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
