{
  "name": "@lucid/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "types": "./src/router.ts",
      "default": "./dist/router.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:production": "node dist/migrate.js",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1107.0",
    "@roackb2/heddle": "5.13.0",
    "@roackb2/heddle-adopter": "5.13.0",
    "@smithy/protocol-http": "5.5.16",
    "@trpc/server": "11.16.0",
    "async-mutex": "0.5.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "lodash": "^4.18.1",
    "pino": "^10.3.1",
    "postgres": "3.4.9",
    "superjson": "^2.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
