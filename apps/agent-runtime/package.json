{
  "name": "@lucid/agent-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/bootstrap/server.ts",
    "invoke": "tsx src/agentcore/local-client.ts",
    "start": "node dist/bootstrap/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@roackb2/heddle": "5.9.0",
    "express": "5.1.0",
    "pino": "10.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
